# ============================================================================
# split.env — single edit point for the train/test split policy.
#
# One line per dataset directory. Edit a line to change how that dataset is
# split; nothing else needs to be touched.
#
# Value grammar (right-hand side):
#   <ratio>,<seed>       stratified split by attack_flag, e.g. 0.20,42
#                        (<ratio> = test fraction, <seed> = random_state).
#                        Loads the whole CSV into memory (pandas).
#   <ratio>,<seed>,lazy  same stratified split, but memory-safe for very large
#                        files: polars scans the CSV lazily and processes one
#                        class at a time (rows end up grouped by class).
#   official             preserve the dataset's ORIGINAL train/test split. These
#                        ship pre-split in their release (e.g. NSL-KDD's
#                        KDDTrain+/KDDTest+, UNSW-NB15's training-/testing-set),
#                        and re-splitting them would break comparability with
#                        published results. Split by the `split` column instead.
#   pipeline             dataset's own download.py already emits training-flow.csv
#                        / test-flow.csv; the split runner skips it.
# ============================================================================

# --- Mechanical settings (not per-dataset) ----------------------------------
# Column used to stratify the split (keeps class balance across train/test).
STRATIFY_COLUMN=attack_flag
# Provenance column marking train/test rows in `official` datasets.
SPLIT_COLUMN=split
# If true, delete the intermediate Reformatted_*.csv after writing the two
# split files, leaving only training-flow.csv / test-flow.csv behind.
CLEAN=true

# --- Preserve original split ------------------------------------------------
nsl-kdd=official
unsw-nb15=official

# --- Own pipeline already emits training-flow / test-flow -------------------
cicids2017=pipeline
cicids2018=pipeline
ciciot2023=pipeline
ton-iot=pipeline
mirai=pipeline

# --- Stratified split (no original split) -----------------------------------
kddcup1999=0.20,42
ctu-13=0.20,42
n-baiot=0.20,42
cidds-001=0.20,42
cidds-002=0.20,42
iotid20=0.20,42
hikari-2021=0.20,42
insdn=0.20,42
cic-ddos2019=0.20,42
kitsune=0.20,42
iot-23=0.20,42
cicids2017-imp=0.20,42
edge-iiot=0.20,42
xiiotid=0.20,42
nf-ton-iot-v3=0.20,42
wustl-iiot-2021=0.20,42
awid2=0.20,42
awid3=0.20,42

# Very large — memory-safe polars lazy split.
bot-iot=0.20,42,lazy
cicids2018-imp=0.20,42,lazy
lspr23=0.20,42,lazy
